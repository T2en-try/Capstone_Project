# PostgreSQL settings used by both the db container and the backend container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=road_reports_batch_db
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@db:5432/road_reports_batch_db

# Public port for nginx on the host machine.
# Change this if the port is already used on your machine.
NGINX_PORT=8081

# Required -- the backend container will not start without this set.
# Generate a fresh value, never reuse a value from any example/doc:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Required -- comma separated list of origins the backend's CORS middleware
# will accept. For local Docker Compose this is usually just the nginx port
# above; for a real deployment, set this to your actual frontend domain(s).
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# Required -- Google Earth Engine service account. init_gee() raises and
# crashes the backend at startup if any of these 3 is missing (not optional).
GEE_SERVICE_ACCOUNT=
GEE_KEY_PATH=./app/services/Road-maintain.json
GEE_PROJECT_ID=

# Optional cloud storage settings.
# Leave these blank if you only want to run the app locally with Docker.
CLOUD_ENDPOINT=
CLOUD_ACCESS_KEY=
CLOUD_SECRET_KEY=
BUCKET_NAME=
