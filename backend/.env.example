# Database
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/road_database

# Server
HOST=0.0.0.0
PORT=8000

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500
