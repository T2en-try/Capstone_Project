DATABASE_URL=postgresql+asyncpg://postgres:<YOUR_PASSWORD>@localhost:5432/road_reports_batch_db
HOST=0.0.0.0
PORT=8000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Allowed Origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Google Earth Engine (GEE)
GEE_SERVICE_ACCOUNT=your-service-account@your-project-id.iam.gserviceaccount.com
GEE_KEY_PATH=./app/services/Road-maintain.json
GEE_PROJECT_ID=your-google-cloud-project-id

# JWT Auth -- required, the app will not start without this set.
# Generate a fresh value locally, never reuse this placeholder:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<generate-with-the-command-above-do-not-commit-a-real-value>